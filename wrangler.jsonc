{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "majstrmap",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "e37e774efbbf8c32fb3e6caf580b3989",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "majstrmap-db",
      "database_id": "5a4c0e20-1651-4664-9a22-d73efe62f85e",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "METRICS_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "MEDIA_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "CONTACTS_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "triggers": {
    "crons": [
      "0 9 1 * *",
      "*/5 * * * *"
    ]
  },
  "routes": [
    { "pattern": "www.majstrmap.site", "custom_domain": true },
    { "pattern": "majstrmap.site", "custom_domain": true }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_BASE_URL": "https://www.majstrmap.site",
    "TELEGRAM_CHANNEL_USERNAME": "@ihornone_official",
    "ADMIN_TELEGRAM_IDS": "8331424769"
  }
}
